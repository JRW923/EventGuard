# 开发态镜像（仅 docker-compose.dev.yml 使用，不影响生产 Dockerfile）。
# 直接用 maven 镜像跑源码，避免每次 mvn package 打 jar；真正编译发生在容器启动时
# （挂载的源码 + maven 缓存），配合 spring-boot-devtools 实现改代码即热重载。
FROM maven:3.9-eclipse-temurin-17
WORKDIR /app
CMD ["sh", "-c", "while true; do mvn -q -o compile -B || true; sleep 2; done & mvn spring-boot:run -B -Dspring-boot.run.fork=false"]
