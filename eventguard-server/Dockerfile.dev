# 开发态镜像（仅 docker-compose.dev.yml 使用，不影响生产 Dockerfile）。
# 直接用 maven 镜像跑源码，避免每次 mvn package 打 jar；真正编译发生在容器启动时
# （挂载的源码 + maven 缓存），配合 spring-boot-devtools 实现改代码即热重载。
FROM maven:3.9-eclipse-temurin-17
WORKDIR /app
# ponytail: 编译循环不用 -o（offline）——maven-cache 卷首次为空时离线模式会因缺插件/依赖而失败，
# 导致 dev 环境首跑起不来。首次在线拉全后本地有缓存，后续联网开销极小。
CMD ["sh", "-c", "while true; do mvn -q compile -B || true; sleep 2; done & mvn spring-boot:run -B -Dspring-boot.run.fork=false"]
