POSTGRES_DB=eventguard
POSTGRES_USER=eventguard
POSTGRES_PASSWORD=changeme
KAFKA_BOOTSTRAP=kafka:9092
DB_URL=jdbc:postgresql://postgres:5432/eventguard
DB_USER=eventguard
DB_PASSWORD=changeme

# AI 服务（eventguard-ai，EG_ 前缀，见 app/config.py）
# 无 Ollama 时 LLM 功能走兜底（intent 关键词、answer 数据摘要、根因分析返回错误），系统仍可演示
EG_LLM_BASE_URL=http://ollama:11434/v1
EG_LLM_API_KEY=ollama
EG_LLM_MODEL=qwen2.5:7b
EG_KAFKA_BOOTSTRAP=kafka:9092
EG_SERVER_BASE_URL=http://eventguard-server:8080

# 登录鉴权（JWT + RBAC，见 README「权限管理」）
# EG_JWT_SECRET：签发/校验用户 JWT 的密钥（eventguard-server 与 eventguard-ai 共用，HS256）。
# 生产必须用强随机值（如 openssl rand -hex 32）
EG_JWT_SECRET=change-me-to-a-random-32-byte-secret-0123456789
# EG_MACHINE_API_KEY：内部服务调用密钥（AI→server、gatling/chaos 运维工具），仅授受限权限
EG_MACHINE_API_KEY=change-me-machine-key

# 种子默认账号初始密码（AuthDataSeeder 写入，三个账号首次登录强制改密）
# EG_ADMIN_PASSWORD=admin123456
# EG_OPERATOR_PASSWORD=operator123456
# EG_VIEWER_PASSWORD=viewer123456

# pip 索引源（仅构建 AI 镜像时使用）；国内部署改为腾讯/清华镜像以避免 PyPI 超时
# PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
PIP_INDEX_URL=https://pypi.org/simple

# Cloudflare Tunnel 令牌（免备案 HTTPS 访问，详见 docs/deploy-cloudflare-tunnel.md）
# 由 `cloudflared tunnel token <name>` 生成；填入后 docker-compose 的 cloudflared 服务才连得回 Cloudflare。
# 不填则隧道服务无法启动，但其余服务不受影响。.env 本身已被 .gitignore 忽略，不会提交。
TUNNEL_TOKEN=
