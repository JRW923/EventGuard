{
  "uid": "eventguard-benchmark",
  "title": "EventGuard 评测 / 业务可观测",
  "tags": ["eventguard", "benchmark"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "命令吞吐（成功 QPS）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(eventguard_command_total{result=\"success\"}[1m])) by (command)", "legendFormat": "{{command}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "命令延迟 p95（ms）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(eventguard_command_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p95" }],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Saga 终态分布",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum(rate(eventguard_saga_final_status_total[1m])) by (status)", "legendFormat": "{{status}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "异常告警接收（按规则）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "sum(rate(eventguard_anomaly_alert_received_total[1m])) by (rule_id)", "legendFormat": "{{rule_id}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "AI 事件消费（rps）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{ "expr": "rate(eventguard_ai_events_consumed_total[1m])", "legendFormat": "events/s" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "AI 检测处理延迟 p95（s）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(eventguard_ai_detection_latency_seconds_bucket[1m])) by (le))", "legendFormat": "p95" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "AI 异常发布（按来源/规则）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [{ "expr": "sum(rate(eventguard_ai_anomalies_published_total[1m])) by (source, rule_id)", "legendFormat": "{{source}}/{{rule_id}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "读己写 / 投影延迟",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(eventguard_read_your_writes_duration_seconds_bucket[1m])) by (le))", "legendFormat": "read-your-write p95" },
        { "expr": "sum(rate(eventguard_projection_lag_total[1m]))", "legendFormat": "projection lag" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "限流拒绝 / 支付回调 / NL 查询",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        { "expr": "rate(eventguard_ratelimit_rejected_total[1m])", "legendFormat": "ratelimit 429" },
        { "expr": "histogram_quantile(0.95, sum(rate(eventguard_payment_callback_duration_seconds_bucket[1m])) by (le))", "legendFormat": "callback p95(s)" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "NL 查询（按意图）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [{ "expr": "sum(rate(eventguard_ai_nl_query_total[1m])) by (intent)", "legendFormat": "{{intent}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    }
  ]
}
