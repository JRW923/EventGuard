{
    admin off
    auto_https off
}

# 单一入口门户：8890 端口，首页聚合面板，子路径反代到各后端。
# 各后端已配子路径基线（Grafana serve_from_sub_path / Prometheus&Alertmanager route-prefix / Kafka-UI context-path）。
:8890 {
    root * /var/www/portal
    file_server

    @grafana path /grafana*
    handle @grafana {
        reverse_proxy grafana:3000
    }

    @prom path /prometheus*
    handle @prom {
        reverse_proxy prometheus:9090
    }

    @alerts path /alerts*
    handle @alerts {
        reverse_proxy alertmanager:9093
    }

    @kafka path /kafka*
    handle @kafka {
        reverse_proxy kafka-ui:8080
    }

    @db path /db*
    handle @db {
        reverse_proxy adminer:8080
    }
}
