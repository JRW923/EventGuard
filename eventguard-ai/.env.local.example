# 在 eventguard-ai 目录运行 uvicorn 时使用：先将以下变量导入当前终端。
EG_KAFKA_BOOTSTRAP=localhost:9092
EG_SERVER_BASE_URL=http://localhost:8080
EG_RULE_ENGINE_URL=http://localhost:8080/anomaly/rules/evaluate
EG_JWT_SECRET=eventguard-dev-secret-change-me-0123456789abcdef
EG_MACHINE_API_KEY=dev-machine-key

# 默认沿用项目提供的 LLM 配置；没有本地 Ollama 时，NL 查询和报告会走代码兜底。
EG_LLM_BASE_URL=http://localhost:11434/v1
EG_LLM_API_KEY=ollama
EG_LLM_MODEL=qwen2.5:7b

